name = CUDA
files = *.cu *.cuh
icon = cu green
comment = //
block = /* */
region = R"( )" string multiline
string = " \
string = ' \
prefix = #p
captypes = yes
keywords = if else for while do switch case default break continue return goto sizeof typedef struct union enum static extern const volatile inline register auto class namespace template typename using public private protected virtual override final friend explicit operator new delete this throw try catch noexcept constexpr consteval constinit decltype mutable static_cast dynamic_cast const_cast reinterpret_cast co_await co_return co_yield concept requires export import module alignas alignof static_assert thread_local __global__ __device__ __host__ __shared__ __constant__ __managed__ __restrict__
types = void char short int long float double signed unsigned bool size_t ssize_t int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t wchar_t char8_t char16_t char32_t string string_view vector map unordered_map set unordered_set array optional variant unique_ptr shared_ptr weak_ptr pair tuple function dim3
constants = nullptr NULL true false
builtins = std cout cerr endl printf malloc free move forward make_unique make_shared threadIdx blockIdx blockDim gridDim warpSize cudaMalloc cudaMemcpy cudaFree cudaDeviceSynchronize
