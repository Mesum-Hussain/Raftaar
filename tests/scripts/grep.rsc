# find in files: smart case, opening a result selects the match, selection as the query;
# wait-grep stands for the frames in which it reads the project's files
cmd find_in_files
wait-grep
type quokka
key Down
key Return
print-state
cmd find_in_files
wait-grep
key Return
print-state
cmd find_in_files
wait-grep
type Quokka
key Return
print-state
cmd find_in_files
wait-grep
type zzq
type qzz
key Return
print-state
key Escape
quit
