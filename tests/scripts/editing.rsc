# typing, auto pairs, auto indent, undo/redo, line commands
cmd new_file
cmd select_language
type C
key Return
type int main(void) {
key Return
type if (x) return "a
key End
key Return
type y = [1, 2
print-doc
key ctrl+z
print-doc
key ctrl+shift+z
key ctrl+shift+d
key alt+Up
print-doc
key ctrl+shift+k
key ctrl+/
print-doc
key ctrl+a
key BackSpace
type a	b
print-doc
print-state
quit
