# dead keys and the Compose key: escapes, keysym results, includes, overrides, cancelling
cmd new_file
key dead_acute
type e
key dead_acute
type E
key Multi_key
type o
type c
key Multi_key
type -
type >
key Multi_key
key U2192
key U2192
key dead_tilde
type n
key Multi_key
type q
type q
key dead_acute
type x
key Multi_key
key Escape
type z
print-doc
key dead_acute
key ctrl+a
type !
print-doc
quit
