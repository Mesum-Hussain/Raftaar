# a repository with a remote for tests/scripts/gitscm.rsc, made in the directory given: the remote has a
# commit the repository has not fetched yet, which changes the line it changes too
set -e
cd "$1"
export GIT_CONFIG_NOSYSTEM=1 HOME="$1"
export GIT_AUTHOR_NAME=Ann GIT_AUTHOR_EMAIL=ann@example.com GIT_COMMITTER_NAME=Ann GIT_COMMITTER_EMAIL=ann@example.com
at() { export GIT_AUTHOR_DATE="2026-01-0$1T10:00:00Z" GIT_COMMITTER_DATE="2026-01-0$1T10:00:00Z"; }
git init -q --bare -b main remote.git
git init -q -b main repo
cd repo
git config user.name Ann
git config user.email ann@example.com
# relative, so that merge messages name it the same everywhere
git remote add origin ../remote.git
at 1
printf 'one\ntwo\nthree\n' > a.txt
git add a.txt
git commit -q -m First
git push -q -u origin main 2>/dev/null
# origin/HEAD from the start: git fetch makes it anyway since git 2.48, so every version shows the same
git remote set-head origin main
cd ..
git clone -q remote.git other
cd other
git config user.name Bob
git config user.email bob@example.com
at 2
printf 'ONE\ntwo\nthree\n' > a.txt
git commit -q -am 'Shout one'
git push -q 2>/dev/null
cd ../repo
# uncommitted: a.txt, where the remote changed it too, and a new file
printf 'uno\ntwo\nthree\n' > a.txt
echo note > notes.txt
